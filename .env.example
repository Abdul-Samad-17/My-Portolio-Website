# LLM Configuration for AI Twin
# Used in src/app/api/chat/route.ts for the AI twin integration.

# The LLM API Key (e.g. from Groq)
LLM_API_KEY=""

# The base URL of the LLM endpoint
LLM_BASE_URL="https://api.groq.com/openai/v1/chat/completions"

# Override default model. The AI Twin uses tool calling, so the model MUST
# support the OpenAI `tools` parameter (function calling).
# AI_MODEL="qwen/qwen3.8-27b"

# Resend contact form delivery
# Use onboarding@resend.dev as sender until you verify your own domain.
RESEND_API_KEY="re_your_resend_api_key"
CONTACT_EMAIL_FROM="Abdul Samad Portfolio <onboarding@resend.dev>"
CONTACT_EMAIL_TO="your-email@example.com"
